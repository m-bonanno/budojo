{
  "name": "@budojo/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Electron shell for Budojo Desktop — serves the Angular build over app:// and supervises the bundled PHP runtime. See M11 (#1218).",
  "author": "Budojo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Budojo/budojo.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "fetch:php": "node scripts/fetch-php.mjs",
    "dev": "npm run build && cross-env ELECTRON_DEV=1 electron dist/main.js",
    "start": "npm run build && electron dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "package:dir": "electron-builder --dir --config electron-builder.yml --publish never",
    "dist": "npm run clean && npm run build && npm run check:package && npm run build:renderer && npm run fetch:php && npm run package"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
